<idea-plugin>
    <id>io.yamsergey.dta</id>
    <name>DTA - Development Tools for Android</name>
    <vendor url="https://github.com/yamsergey/dta">Sergey Yamshchikov</vendor>
    <description><![CDATA[
<p>See what your Android app does while it runs: its screen as one View/Compose tree, and its
HTTP and WebSocket traffic in one live list with bodies (protobuf decoded). Change traffic with
network scripts, and give coding agents the same tools over a local MCP server.</p>
    ]]></description>

    <depends>com.intellij.modules.androidstudio</depends>
    <depends>org.jetbrains.android</depends>
    <depends>com.intellij.gradle</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DTA"
                    anchor="bottom"
                    factoryClass="io.yamsergey.dta.studio.toolwindow.DtaToolWindowFactory"
                    icon="/icons/dta-13.svg"/>
        <applicationConfigurable parentId="tools"
                                 id="io.yamsergey.dta.settings"
                                 displayName="DTA"
                                 instance="io.yamsergey.dta.studio.inject.InjectionConfigurable"/>
        <!-- Feature 056: the former Agents and Schemas tabs. -->
        <applicationConfigurable parentId="io.yamsergey.dta.settings"
                                 id="io.yamsergey.dta.settings.agents"
                                 displayName="Agents"
                                 instance="io.yamsergey.dta.studio.settings.AgentsConfigurable"/>
        <projectConfigurable parentId="io.yamsergey.dta.settings"
                             id="io.yamsergey.dta.settings.protobuf"
                             displayName="Protobuf"
                             instance="io.yamsergey.dta.studio.settings.ProtobufConfigurable"/>
        <postStartupActivity implementation="io.yamsergey.dta.studio.agents.AgentServerStartup"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <taskManager implementation="io.yamsergey.dta.studio.inject.SidekickInjector"/>
    </extensions>
</idea-plugin>
