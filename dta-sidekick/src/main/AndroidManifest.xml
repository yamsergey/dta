<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Attaches the network-capture hook agent before AndroidX Startup and the
             app's own initializers (initOrder: higher runs first). -->
        <provider
            android:name="io.yamsergey.dta.sidekick.hooks.HooksProvider"
            android:authorities="${applicationId}.dta-hooks"
            android:exported="false"
            android:initOrder="1000" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="io.yamsergey.dta.sidekick.SidekickInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
